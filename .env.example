NEXT_PUBLIC_SUPABASE_URL=https://xexzplnyzblflucfvbwt.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

AI_GATEWAY_API_KEY=
MUSAIX_MODEL=openai/gpt-5.5
GOOGLE_GENERATIVE_AI_API_KEY=
OPENAI_API_KEY=

# Artist research does not read the keys above.
# Leave this unset. openai, google, gemini, vercel, and gateway are refused and are not called.
ARTIST_RESEARCH_SYNTHESIS_PROVIDER=

MUSAIX_AUDIO_API_URL=http://localhost:8080
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Sentry error tracking. Leave unset to disable Sentry completely.
# Next.js app (set these on the Vercel project musaix-pro-2026, team sterl27)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
# Optional. Release defaults to VERCEL_GIT_COMMIT_SHA (or the git SHA).
SENTRY_RELEASE=
SENTRY_ENVIRONMENT=

# Audio API: set SENTRY_DSN, SENTRY_RELEASE (or GIT_SHA), and SENTRY_ENVIRONMENT
# on Cloud Run / Fly / Render. Those names are the same, in that service's env.
