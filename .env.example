NEXT_PUBLIC_SUPABASE_URL=https://xexzplnyzblflucfvbwt.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# This Supabase project rejects sign-up, sign-in, and password reset without a captcha token.
# Set the public site key and provider (hcaptcha or turnstile) to show the widget.
# Leave both blank if bot protection is turned off in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_CAPTCHA_SITE_KEY=
NEXT_PUBLIC_SUPABASE_CAPTCHA_PROVIDER=hcaptcha

AI_GATEWAY_API_KEY=
MUSAIX_MODEL=openai/gpt-5.5
GOOGLE_GENERATIVE_AI_API_KEY=
OPENAI_API_KEY=

# Artist research does not read the keys above.
# Leave this unset. openai, google, gemini, vercel, and gateway are refused and are not called.
ARTIST_RESEARCH_SYNTHESIS_PROVIDER=

MUSAIX_AUDIO_API_URL=http://localhost:8080
NEXT_PUBLIC_APP_URL=http://localhost:3000
